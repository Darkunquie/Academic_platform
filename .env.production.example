# =============================================================
# PRODUCTION env template — fill, then paste into Vercel/Coolify/Hetzner UI
# Never commit the filled file. Never paste filled values in chat.
# =============================================================

# --- Database (Neon serverless Postgres) ---
# 1. Sign up: https://neon.tech
# 2. Create project: "Academic Platform"
# 3. Dashboard → Connection details → "Direct connection" → copy URI
# 4. Paste below (must include ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-yyy.us-east-1.aws.neon.tech/academic?sslmode=require

# --- Auth.js ---
# Generate fresh: openssl rand -base64 32   (or pnpm dlx auth secret)
# MUST be a new random string. DO NOT reuse dev AUTH_SECRET.
AUTH_SECRET=
# Public URL of the prod deploy (no trailing slash)
AUTH_URL=https://your-domain.com
# When set, Auth.js trusts AUTH_URL header (needed on Vercel/Coolify behind proxy)
AUTH_TRUST_HOST=true

# --- Groq AI ---
# console.groq.com → API Keys → Create new
# Old key was exposed in dev — generate a fresh one for prod.
GROQ_API_KEY=

# --- Cloudflare R2 (file storage) ---
# Cloudflare dashboard → R2 → bucket "academic-platform" → "Manage R2 API tokens"
# Permissions: Object Read & Write on this bucket only
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=academic-platform
# Optional: custom domain for public asset reads
R2_PUBLIC_URL=

# --- Judge0 sandbox ---
# Option A (fastest): RapidAPI free tier
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_KEY=
# Option B (cheaper at scale): self-host on the same VPS
# JUDGE0_URL=http://judge0:2358
# JUDGE0_KEY=

# --- Optional (Phase H2+) ---
# SENTRY_DSN=
# RESEND_API_KEY=
